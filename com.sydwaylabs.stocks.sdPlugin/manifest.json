{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"UUID": "com.sydwaylabs.stocks",
	"Name": "Stocks",
	"Version": "0.1.0.100",
	"Author": "Sydway Labs",
	"Description": "Live stock, ETF and crypto quotes on your keys — works out of the box, with an optional free Finnhub key.",
	"Category": "Sydway Labs Stocks",
	"CategoryIcon": "imgs/plugin/category",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://github.com/sydwaylabs/stocks",
	"Actions": [
		{
			"Name": "Ticker",
			"UUID": "com.sydwaylabs.stocks.ticker",
			"Icon": "imgs/actions/ticker/icon",
			"Tooltip": "Shows a live quote. Press to refresh, hold for details. On an empty key, press to search for a symbol.",
			"PropertyInspectorPath": "ui/ticker.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ticker/key",
					"TitleAlignment": "middle",
					"Name": "Quote"
				}
			],
			"SupportedInMultiActions": false,
			"UserTitleEnabled": false
		},
		{
			"Name": "Watchlist",
			"UUID": "com.sydwaylabs.stocks.watchlist",
			"Icon": "imgs/actions/watchlist/icon",
			"Tooltip": "Several symbols on one key. Press for the next, hold for details. On an empty key, press to add symbols.",
			"PropertyInspectorPath": "ui/watchlist.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/watchlist/key",
					"TitleAlignment": "middle",
					"Name": "Default"
				}
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"Encoder": {
				"Icon": "imgs/actions/watchlist/icon",
				"layout": "layouts/watchlist.json",
				"TriggerDescription": {
					"Rotate": "Move between symbols",
					"Push": "Open the board",
					"Touch": "Open the board"
				}
			}
		},
		{
			"Name": "Price Alert",
			"UUID": "com.sydwaylabs.stocks.alert",
			"Icon": "imgs/actions/alert/icon",
			"Tooltip": "Turns amber when a price, a move today or a 52-week high or low is reached. Press to clear it, hold for details.",
			"PropertyInspectorPath": "ui/alert.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/alert/key",
					"TitleAlignment": "middle",
					"Name": "Default"
				}
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false
		}
	],
	"CodePath": "bin/plugin.js",
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "6.9"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	]
}